# Configuration locale de JobBot (ce fichier reste sur ton PC, il n'est jamais envoye sur GitHub)

# Obligatoire : ta cle API Anthropic (console.anthropic.com > API Keys), commence par sk-ant-
ANTHROPIC_API_KEY=

# Identifiants de l'interface (http://localhost:5000)
BOT_USERNAME=admin
BOT_PASSWORD=jobbot2024

# Optionnel : cles gratuites France Travail (francetravail.io), voir README
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Candidatures par Gmail (brouillons + suivi + relances)
# 1. Active la validation en 2 etapes sur ton compte Google
# 2. Cree un mot de passe d'application : https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
